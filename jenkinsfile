pipeline {
    agent any

    environment {
        GIT_REPO = 'https://github.com/dgschooldevelopment/Chat_Application.git'  // Your GitHub repo
        GIT_CREDENTIALS_ID = 'GitHubPAT'  // Jenkins credentials ID
        DOCKER_IMAGE_NAME = 'chat_app_image'
        DEPLOY_SERVER_IP = '195.35.45.44:8001'
        DEPLOY_DIR = '/var/www/chat_app'
        CONTAINER_NAME = 'chat_app_container'
    }

    stages {
        stage('Checkout Code') {
            steps {
                script {
                    git branch: 'main', credentialsId: "${GIT_CREDENTIALS_ID}", url: "${GIT_REPO}"
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    // 👇 Build image from backend/ folder where Dockerfile exists
                    dir('backend') {
                        sh "docker build -t ${DOCKER_IMAGE_NAME} ."
                    }
                }
            }
        }

        stage('Stop Existing Container') {
            steps {
                script {
                    sh """
                        docker stop ${CONTAINER_NAME} || true
                        docker rm ${CONTAINER_NAME} || true
                    """
                }
            }
        }

        stage('Run New Container') {
            steps {
                script {
                    // 👇 Run the container with proper port mapping
                    sh """
                        docker run -d --name ${CONTAINER_NAME} -p 8001:8001 ${DOCKER_IMAGE_NAME}
                    """
                }
            }
        }
    }
}
