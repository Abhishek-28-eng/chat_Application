pipeline {
    agent any

    environment {
        GIT_REPO = 'https://github.com/dgschooldevelopment/Chat_Application.git'
        GIT_CREDENTIALS_ID = 'GitHubPAT'
        DOCKER_IMAGE_NAME = 'chat_app_image'
        CONTAINER_NAME = 'chat_app_container'
        HOST_IMAGE_DIR = '/home/chat_app_image'
        CONTAINER_IMAGE_DIR = '/home/chat_app_image'
        PORT = '8001'
    }

    stages {
        stage('Checkout Code') {
            steps {
                script {
                    git branch: 'main', credentialsId: "${GIT_CREDENTIALS_ID}", url: "${GIT_REPO}"
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    dir('backend') {
                        sh "docker build -t ${DOCKER_IMAGE_NAME} ."
                    }
                }
            }
        }

        stage('Stop Existing Container') {
            steps {
                script {
                    sh """
                        docker stop ${CONTAINER_NAME} || true
                        docker rm ${CONTAINER_NAME} || true
                    """
                }
            }
        }

        stage('Run New Container') {
            steps {
                script {
                    sh """
                        docker run -d \
                        --name ${CONTAINER_NAME} \
                        -p ${PORT}:${PORT} \
                        -v ${HOST_IMAGE_DIR}:${CONTAINER_IMAGE_DIR} \
                        ${DOCKER_IMAGE_NAME}
                    """
                }
            }
        }
    }
}
